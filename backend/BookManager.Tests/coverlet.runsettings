<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <!--
            Only the layers unit tests can reach without I/O. Api and Infrastructure are not
            referenced by the test project, so they are never loaded or instrumented anyway.
          -->
          <Include>[BookManager.Application]*,[BookManager.Domain]*</Include>
          <ExcludeByAttribute>CompilerGeneratedAttribute,GeneratedCodeAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
          <!-- Trivial auto-property accessors would otherwise inflate the numbers. -->
          <SkipAutoProps>true</SkipAutoProps>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
